# ComfyUI'nin LAN üzerindeki adresi (http://IP:PORT şeklinde, sonunda / OLMADAN)
VITE_COMFYUI_URL=http://192.168.1.62:8188

# Output Browser sekmeleri — her biri kendi üretim türünün klasöründen
# başlar (bkz. template.json/krea2Template.json/imageTemplate.json'daki
# filename_prefix). Bu yollar dışına asla erişilmez (path traversal engellenir).
VIDEO_OUTPUT_DIR=/home/emir/Desktop/ComfyUI/output/video
KREA_OUTPUT_DIR=/home/emir/Desktop/ComfyUI/output/krea
SDXL_OUTPUT_DIR=/home/emir/Desktop/ComfyUI/output/image

# LoRA klasörü — Civitai fetch sistemi (LoRA önizleme resmi + tetik
# kelimeleri) için kullanılır. ComfyUI'nin kendi models/loras klasörü.
COMFYUI_LORA_DIR=/home/emir/Desktop/ComfyUI/models/loras

# Opsiyonel — civitai.com/user/account -> "API Keys" bölümünden ücretsiz
# oluşturulabilir. Anahtar olmadan da çoğu LoRA (NSFW dahil) bulunuyor, ama
# bazı içerikler anahtarla daha güvenilir geliyor.
CIVITAI_API_KEY=

# Output Browser'ı sunan küçük Node/Express backend'inin portu.
# vite.config.ts bu porta otomatik proxy yapar, değiştirirseniz ikisi de senkron kalır.
OUTPUT_SERVER_PORT=5175

# --- "Ayarlar" sekmesi (opsiyonel — hepsinin varsayılanı yeterli) ---
# llama-swap'in adresi — "Modeller" bölümü buradaki modelleri açıp kapatır.
LLAMA_SWAP_URL=http://127.0.0.1:8080
# "ComfyUI'yi Başlat/Durdur" butonunun çalıştırdığı script. Panel artık
# ayrı bir systemd servisi (mobile-control.service) olduğu için bu script
# SADECE ComfyUI başlatır — "Durdur" paneli kapatmaz.
START_ALL_SCRIPT=/home/emir/Desktop/ComfyUI/start-all.sh
# ComfyUI'nin dinleme portu — "çalışıyor mu" durumunu göstermek için yoklanır.
COMFYUI_PROBE_PORT=8188
