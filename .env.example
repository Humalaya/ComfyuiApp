# ComfyUI'nin LAN üzerindeki adresi (http://IP:PORT şeklinde, sonunda / OLMADAN)
VITE_COMFYUI_URL=http://192.168.1.65:8188

# ComfyUI'nin output klasörünün MUTLAK yolu (Output Browser sekmesi için).
# Bu yol dışına asla erişilmez (path traversal engellenir).
COMFYUI_OUTPUT_DIR=/home/emir/Desktop/ComfyUI/output

# Opsiyonel ikinci kaynak: sd-webui-forge (veya benzeri A1111 tabanlı bir arayüz)
# çıktı klasörü. Ayarlanmazsa Galeri'de bu sekme görünmez.
FORGE_OUTPUT_DIR=/home/emir/Desktop/sd-webui-forge-neo/output/txt2img-images

# Output Browser'ı sunan küçük Node/Express backend'inin portu.
# vite.config.ts bu porta otomatik proxy yapar, değiştirirseniz ikisi de senkron kalır.
OUTPUT_SERVER_PORT=5175
